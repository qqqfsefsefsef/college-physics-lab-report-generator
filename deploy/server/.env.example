# 复制成 .env 再改（cp .env.example .env）

# ── 站点地址 ────────────────────────────────────────────────
# 有域名：写域名本身，Caddy 会自动申请免费 HTTPS（域名要先解析到这台服务器）
#   例：SITE_ADDR=report.abc.com
# 只有 IP、没有域名：写 :80（纯 http；校园网/手机都能开，但没有小绿锁）
#   例：SITE_ADDR=:80
SITE_ADDR=:80

# ── 谁付钱 ──────────────────────────────────────────────────
# 留空（推荐内测）：每个用户在页面上填自己的 key，你一分钱不花
# 填上：服务端统一付钱，所有人都能用你的额度 —— 务必同时设 BRIDGE_TOKEN 和限流
DEEPSEEK_API_KEY=

# ── 访问口令（可选）────────────────────────────────────────
# 设了之后，页面右上角「连接设置」要填同一个口令才能用；防别人白嫖你的接口
BRIDGE_TOKEN=

# ── 生成物保留天数（默认 7 天，定时清理 web-* 目录）────────
PROJECT_KEEP_DAYS=7
